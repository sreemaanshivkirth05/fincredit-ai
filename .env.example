# Docker Compose local inference. Copy to .env; never commit real credentials.
# Select a model already installed in your own Ollama instance.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=384
HF_ALLOW_OLLAMA_FALLBACK=false
SIMULATION_ENABLED=false

# Optional existing HF Space; it must be operational before selecting huggingface.
HF_SPACE_ID=Sreemaan05/fincredit-ai-inference
HF_TOKEN=
FINCREDIT_SPACE_KEY=
HF_TIMEOUT_SECONDS=90
