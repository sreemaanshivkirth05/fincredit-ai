# Docker Compose local inference. Copy to .env; never commit real credentials.
# Select a model already installed in your own Ollama instance.
POSTGRES_PASSWORD=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=384
HF_ALLOW_OLLAMA_FALLBACK=false
SIMULATION_ENABLED=false
SIMULATION_MAX_AGENTS=6
SIMULATION_MAX_ROUNDS=10
SIMULATION_MAX_MODEL_CALLS=40
SIMULATION_PROVIDER=ollama
SIMULATION_MODEL=
SIMULATION_MAX_OUTPUT_TOKENS=768
SIMULATION_MAX_RUNTIME_SECONDS=3600
SIMULATION_STALE_SECONDS=600

# Free cloud mode. The Space must be deployed before selecting huggingface.
# Models: Qwen/Qwen3-8B (reasoning) and the Apache-2.0 DistilRoBERTa
# financial sentiment classifier documented in docs/HUGGINGFACE_INFERENCE.md.
HF_SPACE_ID=Sreemaan05/fincredit-ai-inference
HF_TOKEN=
FINCREDIT_SPACE_KEY=
HF_TIMEOUT_SECONDS=180
