APP_NAME=FinCredit AI
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fincredit_ai
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEMO_USER_EMAIL=demo@fincredit.ai
DEMO_USER_PASSWORD=DemoPass123!
ADMIN_USER_EMAIL=admin@fincredit.ai
ADMIN_USER_PASSWORD=AdminPass123!
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MAX_OUTPUT_TOKENS=768
LLM_TIMEOUT_SECONDS=20

# Free Hugging Face Space inference. Keep tokens and keys out of Git.
LLM_PROVIDER=ollama
HF_SPACE_ID=Sreemaan05/fincredit-ai-inference
HF_TOKEN=
FINCREDIT_SPACE_KEY=
HF_TIMEOUT_SECONDS=180
HF_ALLOW_OLLAMA_FALLBACK=false

# Phase 1 saves configuration only. Never launches agents or trades.
SIMULATION_ENABLED=false
SIMULATION_MAX_AGENTS=6
SIMULATION_MAX_ROUNDS=10
SIMULATION_MAX_MODEL_CALLS=40
SIMULATION_PROVIDER=ollama
# Empty inherits the configured provider's model identifier; no model is downloaded.
SIMULATION_MODEL=
