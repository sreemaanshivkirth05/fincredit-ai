{
  "name": "FinCredit AI (manual Compose startup)",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "FinCredit frontend", "onAutoForward": "notify", "protocol": "http" },
    "8000": { "label": "FinCredit API", "onAutoForward": "notify", "protocol": "http" },
    "5432": { "onAutoForward": "ignore" },
    "11434": { "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "postAttachCommand": "bash .devcontainer/private-ports.sh",
  "remoteUser": "vscode"
}
