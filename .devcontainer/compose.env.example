# Non-secret Compose interpolation defaults. Do not put credentials here.
# Explicit --env-file prevents loading the workstation's root .env.
LLM_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=384
SIMULATION_ENABLED=false
SIMULATION_MAX_OUTPUT_TOKENS=384
SIMULATION_MAX_RUNTIME_SECONDS=3600
SIMULATION_STALE_SECONDS=600
